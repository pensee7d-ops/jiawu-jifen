[Unit]
Description=Chores points check-in site
After=network.target

[Service]
Type=simple
User=chores
WorkingDirectory=/opt/chores/jiawu-jifen/app
EnvironmentFile=/opt/chores/jiawu-jifen/app/.env
ExecStart=/opt/chores/jiawu-jifen/app/.venv/bin/uvicorn chores.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
MemoryMax=180M
CPUQuota=60%
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
